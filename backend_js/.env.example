# Banco de dados
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# MySQL remoto: TLS é aplicado automaticamente quando DB_HOST não é localhost/127.0.0.1

# Segurança
JWT_SECRET=
# Tempo de expiração dos tokens JWT (padrão: 7d)
# Exemplos: 1h, 24h, 7d, 30d
JWT_EXPIRES_IN=7d
SESSION_SECRET=
# 32 bytes em base64 (openssl rand -base64 32). Obrigatório em produção.
ENCRYPTION_MASTER_KEY=

# Ambiente de logs: dev = logs detalhados | prod = silencioso (exceto error/critical)
# Desenvolvimento local / homologação:
ENV=dev
# Produção (descomente e comente ENV=dev acima):
# ENV=prod

# URLs
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:8080
# Caminho do build Flutter Web (index.html) para Open Graph dinâmico em /edital/:id
# FLUTTER_WEB_ROOT=/www/wwwroot/br_permutapolicial/br.permutapolicial.com/public_html

# OAuth Google (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Sign-In nativo no APK (audiences aceitas no POST /api/auth/google/native)
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_SERVER_CLIENT_ID=

# OAuth Microsoft (opcional)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Se todos os usuários forem do mesmo tenant Azure AD, defina o GUID do tenant
# para eliminar o aviso "validate the issuer" e usar validateIssuer nativo.
# Omita para multi-tenant (/common) — o backend valida o issuer manualmente.
# MICROSOFT_TENANT_ID=
MICROSOFT_CALLBACK_URL=

# E-mail SMTP (obrigatório para cadastro por e-mail/senha)
MAIL_HOST=mail.permutapolicial.com.br
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
# Remetente (opcional; padrão = MAIL_USER)
# MAIL_FROM=noreply@permutapolicial.com.br
# Se o certificado SSL do servidor for do domínio raiz (ex: permutapolicial.com.br)
# mas MAIL_HOST for mail.permutapolicial.com.br, defina o nome do certificado:
# MAIL_TLS_SERVERNAME=permutapolicial.com.br
# Apenas se o servidor usar certificado self-signed (não recomendado em produção):
# MAIL_REJECT_UNAUTHORIZED=false
# Porta 465 com SSL explícito:
# MAIL_PORT=465
# MAIL_SECURE=true

# Ambiente
NODE_ENV=development
PORT=3000

# Motor experimental Permutas Inteligentes (isolado do /api/permutas)
ENABLE_PERMUTAS_INTELIGENTES_JOB=true
PI_GRAPH_TTL_HOURS=2
PI_USER_CACHE_TTL_HOURS=1
PI_JOB_USER_LIMIT=200

# Cloudflare R2 / CDN (upload de fotos do mapa tático e marketplace)
# Endpoint = só a conta R2, SEM /nome-do-bucket no final:
# AWS_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=permutapolicial-images
CDN_URL=https://cdn.br.permutapolicial.com.br
# CORS no bucket R2 (Cloudflare → R2 → bucket → Settings → CORS):
# AllowedOrigins: https://br.permutapolicial.com.br, https://dev.br.permutapolicial.com.br
# AllowedMethods: GET, HEAD
# AllowedHeaders: *

# Google Vision API (OCR de documentos) — usa o MESMO service account JSON do FCM abaixo.
# Loga OCR no console do servidor (funciona em produção — usa stdout direto).
# Mostra linhas do Vision + campos extraídos no submit.
VERIFICACAO_OCR_VISION_LOG=1
# Habilite "Cloud Vision API" no Google Cloud Console do projeto Firebase.
# Opcional (fallback): chave Web simples — prefira o JSON do FCM.
# GOOGLE_VISION_API_KEY=

# Push FCM HTTP v1
# ⚠️ NÃO coloque JSON multilinha em FCM_SERVICE_ACCOUNT_JSON — dotenv só lê a 1ª linha ("{").
#
# Forma recomendada (aaPanel / /www/wwwroot/permutabr_api):
# 1. Salve o JSON baixado do Firebase como:
#    /www/wwwroot/permutabr_api/firebase-service-account.json
# 2. No .env, APENAS:
# FCM_PROJECT_ID=permuta-policial-ofc
# FCM_WEB_LINK_BASE=https://br.permutapolicial.com.br
# FCM_SERVICE_ACCOUNT_PATH=/www/wwwroot/permutabr_api/firebase-service-account.json
#
# Alternativa: FCM_SERVICE_ACCOUNT_JSON_B64=<base64 de uma linha>
# FCM_WEB_LINK_BASE=https://br.permutapolicial.com.br
